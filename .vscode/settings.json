{
  // main is production. VS Code asks before committing on it and offers a new branch instead.
  // Rules: docs/GIT-WORKFLOW.md
  "git.branchProtection": ["main"],
  "git.branchProtectionPrompt": "alwaysPrompt",
  "git.autofetch": true,
  "git.pruneOnFetch": true,
  "git.confirmSync": true,
  "git.postCommitCommand": "none",

  // Formatting: Prettier on save (.prettierrc.json), ESLint for bugs (eslint.config.js). Same rules as CI.
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "eslint.useFlatConfig": true,
  "files.eol": "\n"
}
